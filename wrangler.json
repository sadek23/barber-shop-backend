{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "barber-backend",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "workers_dev": true,
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "barber_shop_db",
      "database_id": "80849b32-9ddb-4a47-8fe7-98d947ffe721"
    }
  ],

  "vars": {
    "JWT_SECRET": "barber-shop-super-secret-jwt-key-change-in-prod",
    "FRONTEND_URL": "http://localhost:3000"
  }
}
